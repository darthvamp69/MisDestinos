{
  "expo": {
    "name": "Mis Destinos",
    "slug": "mis-destinos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pintravel",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.josemarinao.pintravel",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Se usa tu ubicación para centrar el mapa en dónde estás.",
        "NSPhotoLibraryUsageDescription": "Se usa tu galería para adjuntar fotos a los lugares."
      }
    },
    "android": {
      "package": "com.josemarinao.pintravel",
      "adaptiveIcon": {
        "backgroundColor": "#0f1720",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        { "locationWhenInUsePermission": "Se usa tu ubicación para centrar el mapa en dónde estás." }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa tu galería para adjuntar fotos a los lugares.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
